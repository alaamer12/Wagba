{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "domains": {
      "vue": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/**"],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "error",
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "quasar": "Framework imports belong to src/ui/base/**. Consume the seam instead (docs/tech/structure.md §3.8).",
                  "@quasar/extras": "Framework imports belong to src/ui/base/**. Consume the seam instead (docs/tech/structure.md §3.8)."
                },
                "patterns": [
                  {
                    "group": ["@quasar/extras/**"],
                    "message": "Framework imports belong to src/ui/base/**. Consume the seam instead (docs/tech/structure.md §3.8)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/ui/base/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["src/shared/behaviour/PullRefresh.vue"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["src/css/**"],
      "linter": {
        "rules": {
          "style": {
            "noDescendingSpecificity": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.vue"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          },
          "style": {
            "useConst": "off",
            "useImportType": "off"
          }
        }
      }
    }
  ],
  "files": {
    "includes": [
      "src/**",
      "shared/**",
      "tools/**",
      "tests/**",
      "*.ts",
      "*.js",
      "!src/assets",
      "!src/lib/avatar-parts.ts"
    ]
  }
}
