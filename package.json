{
  "name": "wagba",
  "version": "0.1.0",
  "description": "Home-cooked meals, discovered nearby.",
  "productName": "Wagba",
  "author": "alaamer12",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "quasar dev",
    "build": "quasar build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "gate": "bun tools/gate.mjs",
    "docs:check": "bun tools/linkcheck.mjs",
    "pb": "bun tools/pb.mjs",
    "seed": "bun tools/seed.mjs",
    "hooks": "bun tools/build-hooks.mjs",
    "postinstall": "quasar prepare --silent"
  },
  "dependencies": {
    "@capacitor/app-launcher": "^7.0.0",
    "@capacitor/browser": "^7.0.0",
    "@capacitor/camera": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/geolocation": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@quasar/extras": "^2.1.0",
    "pinia": "^4.0.2",
    "pocketbase": "^0.26.0",
    "quasar": "^2.35.2",
    "vue": "^3.5.22",
    "vue-i18n": "^11.3.0",
    "vue-router": "^5.0.6",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@intlify/unplugin-vue-i18n": "^11.0.0",
    "@playwright/test": "^1.56.0",
    "@quasar/app-vite": "^3.10.3",
    "@types/node": "^22.19.11",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.27",
    "esbuild": "^0.25.0",
    "happy-dom": "^18.0.0",
    "postcss": "^8.5.8",
    "typescript": "^6.0.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.3.3"
  },
  "engines": {
    "node": ">= 22.12"
  }
}
