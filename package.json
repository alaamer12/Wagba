{
  "name": "wagba",
  "version": "0.1.0",
  "description": "Home-cooked meals, discovered nearby.",
  "productName": "Wagba",
  "author": "alaamer12",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "quasar dev",
    "build": "quasar build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "pvc": ".venv/Scripts/python.exe tools/check_pvc.py src",
    "states:check": "bun tools/states-check.ts",
    "chain:check": "bun tools/chain-check.ts",
    "gate": "bun tools/gate.ts",
    "gate:full": "bun tools/gate.ts --full",
    "stress": "bun tools/stress.ts",
    "audit": ".venv/Scripts/python.exe tools/db-audit.py",
    "docs:check": "bun tools/linkcheck.ts",
    "pb": "bun tools/pb.mjs",
    "seed": "bun tools/seed.mjs",
    "hooks": "bun tools/build-hooks.mjs",
    "postinstall": "quasar prepare --silent",
    "avatar:build": "bun tools/build-avatar.ts"
  },
  "dependencies": {
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.6.0",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/preferences": "^8.0.1",
    "@quasar/extras": "^2.1.0",
    "pinia": "^4.1.0",
    "pocketbase": "^0.28.1",
    "quasar": "^2.35.2",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@intlify/unplugin-vue-i18n": "^11.2.8",
    "@playwright/test": "^1.64.1",
    "@quasar/app-vite": "^3.10.3",
    "@types/node": "^26.6.6",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.2",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "postcss": "^8.5.32",
    "typescript": "5.9.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": ">= 22.12"
  }
}
